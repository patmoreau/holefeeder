{
  "name": "holefeeder-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "start": "APP_ENV=development expo start",
    "android": "APP_ENV=development expo run:android",
    "prebuild:dev": "APP_ENV=development expo prebuild --clean --platform ios",
    "prebuild:ios:deploy": "APP_ENV=production expo prebuild --clean --platform ios",
    "ios": "APP_ENV=development expo run:ios",
    "preios:deploy": "pnpm run prebuild:ios:deploy",
    "ios:deploy": "APP_ENV=production expo run:ios --configuration Release --device",
    "web": "APP_ENV=development expo start --web",
    "lint": "eslint .",
    "test": "jest",
    "test:e2e:ios": "maestro test --include-tags=regression .maestro/",
    "npx:fix": "npx expo install --fix"
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "2.19.2",
    "@azure/core-asynciterator-polyfill": "1.0.2",
    "@expo/html-elements": "56.0.1",
    "@expo/material-symbols": "^0.1.1",
    "@expo/metro-runtime": "^56.0.15",
    "@expo/ui": "56.0.18",
    "@expo/vector-icons": "15.1.1",
    "@holefeeder/shared": "workspace:*",
    "@op-engineering/op-sqlite": "15.2.12",
    "@powersync/common": "1.52.0",
    "@powersync/op-sqlite": "0.9.6",
    "@powersync/react": "1.10.0",
    "@powersync/react-native": "1.34.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-picker/picker": "2.11.4",
    "@shopify/flash-list": "2.0.2",
    "date-fns": "4.1.0",
    "dotenv": "17.4.2",
    "expo": "56.0.12",
    "expo-build-properties": "56.0.19",
    "expo-constants": "~56.0.18",
    "expo-crypto": "56.0.4",
    "expo-dev-client": "56.0.20",
    "expo-file-system": "^56.0.8",
    "expo-font": "56.0.7",
    "expo-glass-effect": "56.0.4",
    "expo-haptics": "56.0.3",
    "expo-image": "56.0.11",
    "expo-linking": "56.0.14",
    "expo-localization": "56.0.6",
    "expo-quick-actions": "6.0.1",
    "expo-router": "56.2.11",
    "expo-sharing": "^56.0.18",
    "expo-splash-screen": "56.0.10",
    "expo-status-bar": "56.0.4",
    "expo-symbols": "56.0.6",
    "expo-system-ui": "56.0.5",
    "expo-web-browser": "56.0.5",
    "i18next": "26.0.10",
    "js-logger": "1.6.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "17.0.7",
    "react-native": "0.85.3",
    "react-native-auth0": "5.5.1",
    "react-native-error-boundary": "3.1.0",
    "react-native-gesture-handler": "2.31.2",
    "react-native-logs": "^5.6.0",
    "react-native-mmkv": "^4.3.1",
    "react-native-nitro-modules": "^0.35.6",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-ui-datepicker": "3.1.3",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.8.3"
