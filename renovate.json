{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>patmoreau/renovate-config", "config:recommended"],
  "packageRules": [
    {
      "matchManagers": ["nuget"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Drifterapps minor and patch updates",
      "groupSlug": "drifterapps-seeds-updates",
      "matchPackageNames": ["/^DrifterApps.Seeds./"]
    },
    {
      "matchManagers": ["nuget"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Microsoft minor and patch updates",
      "groupSlug": "microsoft-minor-patch-updates",
      "matchPackageNames": ["/^Microsoft./", "/^System./"]
    },
    {
      "matchManagers": ["nuget"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "3rd parties .NET packages updates",
      "groupSlug": "other-dotnet-updates",
      "matchPackageNames": [
        "!/^Microsoft./",
        "!/^System./",
        "!Microsoft.EntityFrameworkCore",
        "!Pomelo.EntityFrameworkCore.MySql"
      ]
    },
    {
      "description": "The Expo SDK pins these; they move only with an SDK upgrade via expo install --fix.",
      "matchManagers": ["npm"],
      "matchFileNames": ["frontend/**"],
      "matchPackageNames": [
        "react",
        "react-dom",
        "react-native",
        "react-native-web",
        "react-native-gesture-handler",
        "react-native-reanimated",
        "react-native-worklets",
        "react-native-screens",
        "react-native-safe-area-context",
        "@shopify/flash-list",
        "@react-native-async-storage/async-storage",
        "@react-native-picker/picker"
      ],
      "enabled": false
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["frontend/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Frontend minor and patch updates",
      "groupSlug": "frontend-minor-patch-updates"
    },
    {
      "matchManagers": ["nuget"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "groupName": "Nuget major updates",
      "groupSlug": "nuger-major-updates"
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["frontend/**"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "pnpm is pinned twice: packageManager in frontend/package.json and frontend/mise.toml.",
      "matchPackageNames": ["pnpm"],
      "groupName": "pnpm",
      "groupSlug": "pnpm"
    },
    {
      "description": "Majors that must move together.",
      "matchManagers": ["npm"],
      "matchFileNames": ["frontend/**"],
      "matchUpdateTypes": ["major"],
      "matchPackageNames": ["i18next", "react-i18next"],
      "groupName": "i18next major updates",
      "groupSlug": "i18next-major-updates"
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["frontend/**"],
      "matchUpdateTypes": ["major"],
      "matchPackageNames": ["/^@mui\\//"],
      "groupName": "MUI major updates",
      "groupSlug": "mui-major-updates"
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["frontend/**"],
      "matchUpdateTypes": ["major"],
      "matchPackageNames": ["vite", "vitest", "@vitejs/plugin-react"],
      "groupName": "Vite major updates",
      "groupSlug": "vite-major-updates"
    },
    {
      "description": "Peers cap these majors: typescript-eslint and ts-jest for typescript, @powersync/react-native for op-sqlite, and the community CLI follows the React Native version of the Expo SDK.",
      "matchManagers": ["npm"],
      "matchFileNames": ["frontend/**"],
      "matchUpdateTypes": ["major"],
      "matchPackageNames": [
        "typescript",
        "@op-engineering/op-sqlite",
        "@react-native-community/cli"
      ],
      "enabled": false
    },
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
