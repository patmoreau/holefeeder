{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>patmoreau/renovate-config", "config:recommended"],
  "packageRules": [
    {
      "matchManagers": ["nuget"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Drifterapps minor and patch updates",
      "groupSlug": "drifterapps-seeds-updates",
      "matchPackageNames": ["/^DrifterApps.Seeds./"]
    },
    {
      "matchManagers": ["nuget"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Microsoft minor and patch updates",
      "groupSlug": "microsoft-minor-patch-updates",
      "matchPackageNames": ["/^Microsoft./", "/^System./"]
    },
    {
      "matchManagers": ["nuget"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "3rd parties .NET packages updates",
      "groupSlug": "other-dotnet-updates",
      "matchPackageNames": [
        "!/^Microsoft./",
        "!/^System./",
        "!Microsoft.EntityFrameworkCore",
        "!Pomelo.EntityFrameworkCore.MySql"
      ]
    },
    {
      "description": "The Expo SDK pins these; they move only with an SDK upgrade via expo install --fix.",
      "matchManagers": ["npm"],
      "matchFileNames": ["frontend/**"],
      "matchPackageNames": [
        "react",
        "react-dom",
        "react-native",
        "react-native-web",
        "react-native-gesture-handler",
        "react-native-reanimated",
        "react-native-worklets",
        "react-native-screens",
        "react-native-safe-area-context",
        "@shopify/flash-list",
        "@react-native-async-storage/async-storage",
        "@react-native-picker/picker"
      ],
      "enabled": false
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["frontend/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Frontend minor and patch updates",
      "groupSlug": "frontend-minor-patch-updates"
    },
    {
      "matchManagers": ["nuget"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "groupName": "Nuget major updates",
      "groupSlug": "nuger-major-updates"
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["frontend/**"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "groupName": "Frontend major updates",
      "groupSlug": "frontend-major-updates"
    },
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
