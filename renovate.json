{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>patmoreau/renovate-config", "config:recommended"],
  "packageRules": [
    {
      "matchManagers": ["nuget"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Drifterapps minor and patch updates",
      "groupSlug": "drifterapps-seeds-updates",
      "matchPackageNames": ["/^DrifterApps.Seeds./"]
    },
    {
      "matchManagers": ["nuget"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Microsoft minor and patch updates",
      "groupSlug": "microsoft-minor-patch-updates",
      "matchPackageNames": ["/^Microsoft./", "/^System./"]
    },
    {
      "matchManagers": ["nuget"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "3rd parties .NET packages updates",
      "groupSlug": "other-dotnet-updates",
      "matchPackageNames": [
        "!/^Microsoft./",
        "!/^System./",
        "!Microsoft.EntityFrameworkCore",
        "!Pomelo.EntityFrameworkCore.MySql"
      ]
    },
    {
      "description": "Microsoft.AspNetCore.OpenApi 10.0.x pins Microsoft.OpenApi to [2.12.0, 3.0.0). 3.x only becomes usable with .NET 11.",
      "matchManagers": ["nuget"],
      "matchPackageNames": ["Microsoft.OpenApi"],
      "allowedVersions": "<3.0.0"
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["backend/src/Holefeeder.Web/ClientApp/package.json"],
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<5.5.0"
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["backend/src/Holefeeder.Web/ClientApp/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Angular minor and patch updates",
      "groupSlug": "angular-minor-patch-updates"
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["frontend/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Frontend minor and patch updates",
      "groupSlug": "frontend-minor-patch-updates"
    },
    {
      "matchManagers": ["nuget"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "groupName": "Nuget major updates",
      "groupSlug": "nuger-major-updates"
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["frontend/**"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "groupName": "Frontend major updates",
      "groupSlug": "frontend-major-updates"
    },
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "matchFileNames": ["backend/src/Holefeeder.Web/ClientApp/**"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
