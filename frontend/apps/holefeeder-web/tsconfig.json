{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "outDir": "./dist",
    "types": ["vite/client"],
    "paths": {
      "@holefeeder/shared/*": ["../../packages/shared/src/*/index.ts"],
      "@/*": ["./src/*"]
    }
  },
  "references": [{ "path": "../../packages/shared" }],
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}
