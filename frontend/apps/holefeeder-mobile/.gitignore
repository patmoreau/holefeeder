# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
.gradle/
**/build/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*
!.env.template
# Maestro credentials live under .maestro/ because Metro treats any .env*.local in
# the app root as a source file and fails to bundle in dev.
.maestro/.env*.local
!.maestro/.env.e2e.template

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android
/.maestro/test-output/
/dev-client/debug-data