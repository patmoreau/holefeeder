{
  "name": "holefeeder-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "start": "APP_ENV=development expo start",
    "android": "APP_ENV=development expo run:android",
    "prebuild:dev": "APP_ENV=development expo prebuild --clean --platform ios",
    "prebuild:ios:deploy": "APP_ENV=production expo prebuild --clean --platform ios",
    "ios": "APP_ENV=development expo run:ios",
    "preios:deploy": "pnpm run prebuild:ios:deploy",
    "ios:deploy": "APP_ENV=production expo run:ios --configuration Release --no-bundler",
    "ios:e2e": "APP_ENV=development EXPO_PUBLIC_E2E=true expo run:ios --configuration Release --no-bundler",
    "ios:e2e:auth": "APP_ENV=development expo run:ios --configuration Release --no-bundler",
    "web": "APP_ENV=development expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e:ios": "sh .maestro/run.sh regression",
    "test:e2e:auth": "sh .maestro/run.sh auth",
    "test:e2e:onboarding": "sh .maestro/run.sh onboarding",
    "assert:production-safe": "sh scripts/assert-production-has-no-e2e-flag.sh",
    "npx:fix": "npx expo install --fix"
  },
  "dependencies": {
    "@azure/core-asynciterator-polyfill": "1.0.2",
    "@expo/html-elements": "57.0.0",
    "@expo/material-symbols": "0.1.1",
    "@expo/metro-runtime": "57.0.13",
    "@expo/ui": "55.0.17",
    "@expo/vector-icons": "15.1.1",
    "@holefeeder/shared": "workspace:*",
    "@op-engineering/op-sqlite": "15.2.14",
    "@powersync/common": "1.57.3",
    "@powersync/op-sqlite": "0.9.16",
    "@powersync/react": "1.10.0",
    "@powersync/react-native": "1.35.10",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-picker/picker": "2.11.4",
    "@shopify/flash-list": "2.3.2",
    "date-fns": "4.4.0",
    "dotenv": "17.4.2",
    "expo": "55.0.30",
    "expo-build-properties": "55.0.18",
    "expo-constants": "55.0.17",
    "expo-crypto": "55.0.19",
    "expo-dev-client": "55.0.39",
    "expo-file-system": "55.0.26",
    "expo-font": "55.0.8",
    "expo-glass-effect": "57.0.1",
    "expo-haptics": "55.0.18",
    "expo-image": "55.0.11",
    "expo-linking": "55.0.17",
    "expo-localization": "55.0.19",
    "expo-quick-actions": "6.0.2",
    "expo-router": "55.0.18",
    "expo-sharing": "55.0.24",
    "expo-splash-screen": "55.0.25",
    "expo-status-bar": "57.0.1",
    "expo-symbols": "55.0.9",
    "expo-system-ui": "55.0.22",
    "expo-web-browser": "55.0.20",
    "i18next": "26.4.0",
    "js-logger": "1.6.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.12",
    "react-native": "0.87.0",
    "react-native-auth0": "5.11.0",
    "react-native-error-boundary": "3.1.0",
    "react-native-gesture-handler": "2.32.0",
    "react-native-logs": "^5.6.0",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "^0.37.0",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "5.9.1",
    "react-native-screens": "4.27.0",
    "react-native-ui-datepicker": "3.3.0",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.12.1"
  },
  "devDependencies": {
    "@babel/plugin-transform-async-generator-functions": "7.29.7",
    "@babel/runtime": "7.29.7",
    "@expo/config": "~57.0.7",
    "@expo/config-types": "~57.0.2",
    "@faker-js/faker": "10.6.0",
    "@powersync/node": "0.21.0",
    "@react-native-community/cli": "20.2.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/react-native": "14.0.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/jest": "29.5.14",
    "@types/node": "25.9.5",
    "@types/react": "19.2.18",
    "@types/react-native-web": "0.19.2",
    "babel-plugin-react-native-web": "0.21.2",
    "better-sqlite3": "12.11.1",
    "jest": "29.7.0",
    "jest-expo": "55.0.22",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "tslib": "2.8.1",
    "typescript": "6.0.3"
  },
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "browser-tabs-lock",
      "unrs-resolver"
    ],
    "ignoredBuiltDependencies": [
      "react-native-mmkv",
      "react-native-nitro-modules"
    ]
  }
}
