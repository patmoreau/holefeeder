{
  "name": "holefeeder-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "start": "EXPO_UNSTABLE_MCP_SERVER=1 APP_ENV=development expo start",
    "android": "APP_ENV=development expo run:android",
    "prebuild:dev": "APP_ENV=development expo prebuild --clean --platform ios",
    "prebuild:ios:deploy": "APP_ENV=production expo prebuild --clean --platform ios",
    "ios": "APP_ENV=development expo run:ios",
    "preios:deploy": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/bump-deploy-version.mjs && pnpm run prebuild:ios:deploy",
    "ios:deploy": "APP_ENV=production expo run:ios --configuration Release --no-bundler",
    "ios:e2e": "APP_ENV=development EXPO_PUBLIC_E2E=true expo run:ios --configuration Release --no-bundler",
    "ios:e2e:auth": "APP_ENV=development expo run:ios --configuration Release --no-bundler",
    "web": "APP_ENV=development expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "sh .maestro/run.sh",
    "test:e2e:ios": "sh .maestro/run.sh regression",
    "test:e2e:auth": "sh .maestro/run.sh auth",
    "test:e2e:onboarding": "sh .maestro/run.sh onboarding",
    "assert:production-safe": "sh scripts/assert-production-has-no-e2e-flag.sh",
    "npx:fix": "npx expo install --fix"
  },
  "dependencies": {
    "@azure/core-asynciterator-polyfill": "1.0.2",
    "@expo/html-elements": "58.0.3",
    "@expo/material-symbols": "0.1.1",
    "@expo/metro-runtime": "58.0.15",
    "@expo/ui": "58.0.22",
    "@expo/vector-icons": "15.1.1",
    "@holefeeder/shared": "workspace:*",
    "@op-engineering/op-sqlite": "18.2.5",
    "@powersync/common": "2.3.1",
    "@powersync/react": "2.0.2",
    "@powersync/react-native": "2.3.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-picker/picker": "2.11.4",
    "@shopify/flash-list": "2.3.2",
    "date-fns": "4.4.0",
    "dotenv": "18.0.8",
    "expo": "58.0.17",
    "expo-build-properties": "58.0.11",
    "expo-constants": "58.0.13",
    "expo-crypto": "58.0.7",
    "expo-dev-client": "58.0.14",
    "expo-file-system": "58.0.10",
    "expo-font": "58.0.9",
    "expo-glass-effect": "58.0.4",
    "expo-haptics": "58.0.7",
    "expo-image": "58.0.16",
    "expo-linking": "58.0.14",
    "expo-localization": "58.0.5",
    "expo-router": "58.0.25",
    "expo-sharing": "58.0.20",
    "expo-splash-screen": "58.0.11",
    "expo-status-bar": "58.0.4",
    "expo-symbols": "58.0.4",
    "expo-system-ui": "58.0.6",
    "expo-web-browser": "58.0.6",
    "i18next": "26.4.6",
    "js-logger": "1.6.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.18",
    "react-native": "0.88.0",
    "react-native-auth0": "5.11.2",
    "react-native-error-boundary": "3.1.0",
    "react-native-gesture-handler": "3.3.0",
    "react-native-logs": "^5.6.0",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-ui-datepicker": "3.3.0",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-async-generator-functions": "8.0.6",
    "@babel/runtime": "8.0.7",
    "@expo/config": "58.0.6",
    "@expo/config-types": "58.0.3",
    "@faker-js/faker": "10.6.0",
    "@react-native-community/cli": "20.2.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/react-native": "14.1.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-native-web": "0.19.3",
    "babel-plugin-react-native-web": "0.21.4",
    "better-sqlite3": "13.0.3",
    "expo-mcp": "0.2.4",
    "jest": "30.5.2",
    "jest-expo": "58.0.12",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "tslib": "2.8.1",
    "typescript": "6.0.3"
  },
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "browser-tabs-lock",
      "unrs-resolver"
    ],
    "ignoredBuiltDependencies": [
      "react-native-mmkv",
      "react-native-nitro-modules"
    ]
  }
}
