# Copy to .env.e2e.local and fill in real values. Never commit .env.e2e.local.
#
# Auth0 dev-tenant user that is already registered in the backend.
E2E_EMAIL=replace-me@example.com
E2E_PASSWORD=replace-me

# Auth0 dev-tenant user for new users
E2E_NEW_EMAIL=replace-me@example.com
E2E_NEW_PASSWORD=replace-me

# Dedicated Auth0 application with the password grant enabled, used to mint a
# token without a browser. Keep this off the production tenant: it exists so
# tests can bypass the login pages.
E2E_AUTH0_DOMAIN=replace-me.auth0.com
E2E_AUTH0_CLIENT_ID=replace-me
E2E_AUTH0_AUDIENCE=https://replace-me
E2E_AUTH0_REALM=Username-Password-Authentication
E2E_AUTH0_SCOPE="openid profile email read:user write:user"
