{
    "AllowedHosts": "*",
    "Authorization": {
        "Auth0": {
            "MetadataAddress": "https://dev-vx1jio3owhaqdmqa.ca.auth0.com/.well-known/openid-configuration",
            "Audience": "https://holefeeder-api.drifterapps.app"
        }
    },
    "Proxy": {
        "Prefix": "/gateway"
    },
    "Scalar": {
        "Title": "Holefeeder API",
        "OpenApiRoutePattern": "/openapi/v2.json",
        "Authentication": {
            "PreferredSecurityScheme": "OAuth2",
            "OAuth2": {
                "ClientId": "Holefeeder.Api",
                "Scopes": [
                    "read:user",
                    "write:user"
                ]
            }
        }
    },
    "Serilog": {
        "Properties": {
            "ApplicationName": "DrifterApps.Holefeeder.Api",
            "ApplicationVersion": "1.0.0"
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
                }
            }
        ],
        "Enrich": [
            "FromLogContext",
            "WithMachineName",
            "WithThreadId"
        ],
        "Destructure": [
            {
                "Name": "ToMaximumDepth",
                "Args": {
                    "maximumDestructuringDepth": 4
                }
            },
            {
                "Name": "ToMaximumStringLength",
                "Args": {
                    "maximumStringLength": 100
                }
            },
            {
                "Name": "ToMaximumCollectionCount",
                "Args": {
                    "maximumCollectionCount": 10
                }
            }
        ]
    }
}
