COMPOSE_PROJECT_NAME=holefeeder-staging
COMPOSE_DOCKER_CLI_BUILD=1
DOCKER_BUILDKIT=1
# Local/Staging: set to "local" to start the bundled reverse-proxy, adminer,
# portainer and whoami. Leave EMPTY in Production — ingress is provided by the
# homelab gateway Traefik and logs go to stdout (Loki/Grafana).
COMPOSE_PROFILES=local
# Host path of the container-engine socket mounted into Traefik/Portainer.
# Docker (default): /var/run/docker.sock.
# Podman rootless on macOS: the IN-VM socket (no /var/run/docker.sock exists in the
#   machine). Get the uid via `podman machine ssh id -u`: /run/user/<uid>/podman/podman.sock
# Podman rootful on Linux/LXC: /run/podman/podman.sock
DOCKER_SOCK=/var/run/docker.sock
DOCKER_REGISTRY=
VERSION=99.99.99
ASSEMBLY_VERSION=99.99.99

ENV=Development | Production
DOMAIN=

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_APP_USER=
POSTGRES_APP_PASSWORD=
POSTGRES_APP_DB=

POWERSYNC_ADMIN_TOKEN=
