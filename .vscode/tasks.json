{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/backend/DrifterApps.Holefeeder.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/backend/DrifterApps.Holefeeder.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "${workspaceFolder}/backend/DrifterApps.Holefeeder.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "holefeeder test",
            "command": "dotnet",
            "type": "process",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "args": [
                "test",
                "--settings",
                ".runsettings",
                "--filter",
                "FullyQualifiedName!~Holefeeder.Tests.Common"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "holefeeder code coverage report",
            "command": "dotnet",
            "type": "process",
            "args": [
                "reportgenerator",
                "-reports:${workspaceFolder}/backend/coverage/coverage.cobertura.xml",
                "-targetdir:${workspaceFolder}/backend/coverage",
                "-filefilters:-*.g.cs"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "holefeeder code coverage",
            "dependsOn": [
                "holefeeder test",
                "holefeeder code coverage report"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "holefeeder staging",
            "command": "docker",
            "type": "process",
            "args": [
                "compose",
                "-f",
                "${workspaceFolder}/backend/docker-compose.yaml",
                "-f",
                "${workspaceFolder}/backend/docker-compose.override.yaml",
                "up",
                "-d",
                "--build"
            ],
            "options": {
                "cwd": "${workspaceFolder}/backend",
                "env": {
                    "COMPOSE_PROFILES": "local"
                }
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Clean Solution",
            "type": "shell",
            "command": "for d in bin obj; do find . -type d -name \"$d\" -print0 | xargs -0 rm -rf; done",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "group": "build",
            "detail": "Deletes all 'bin' and 'obj' folders in the backend workspace.",
            "problemMatcher": [],
            "presentation": {
                "panel": "dedicated",
                "revealProblems": "never",
                "clear": true
            }
        },
        {
            "label": "mobile: pnpm run ios",
            "type": "shell",
            "command": "pnpm run ios",
            "options": {
                "cwd": "${workspaceFolder}/frontend/apps/holefeeder-mobile"
            },
            "problemMatcher": []
        }
    ]
}
